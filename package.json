{
  "name": "@merlin-chatou/sutairu",
  "version": "1.0.1",
  "description": "CSS framework that creates a minifyed css file on demand with utilities and components",
  "keywords": [
    "CSS",
    "framework",
    "JIT",
    "components",
    "utilities"
  ],
  "files": [
    "bin",
    "lib",
    "themes",
    "scripts",
    "src",
    "playground",
    "index.js"
  ],
  "homepage": "https://github.com/MerlinChatou/sutairu#readme",
  "bugs": {
    "url": "https://github.com/MerlinChatou/sutairu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MerlinChatou/sutairu.git"
  },
  "license": "MIT",
  "author": "Merlin Chatou",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./utils": "./lib/utils/index.js",
    "./icons-meta": "./src/rules/icons/meta/icons-meta.json",
    "./icons-data": "./src/rules/icons/icons.js",
    "./compiler": "./src/compiler.js"
  },
  "bin": {
    "sutairu": "./bin/cli.js",
    "sutairu-play": "./bin/playground.js"
  },
  "scripts": {
    "test": "node --test",
    "test:update": "node --test --test-update-snapshots ./test/*.test.js",
    "add:icon": "node ./scripts/add-icon.mjs",
    "add:icons": "node ./scripts/add-all-icons.mjs",
    "move:icon": "node ./scripts/move-icon.mjs",
    "remove:icon": "node ./scripts/remove-icon.mjs"
  },
  "dependencies": {
    "byte-size": "^9.0.2",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.1",
    "lightningcss": "^1.33.0"
  },
  "volta": {
    "node": "24.22.3",
    "npm": "11.20.0"
  },
  "devDependencies": {
    "svg-path-bbox": "^2.1.0",
    "svgo": "^4.1.0",
    "svgpath": "^2.6.0"
  }
}
